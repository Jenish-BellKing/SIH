# IBVAP Environment Variables Template
# Copy this file to .env for local configuration

# ==========================================
# Backend & API Configuration (Team 1)
# ==========================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./ibvap.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# AI Model Configuration (Team 1)
# ==========================================
YOLO_MODEL_PATH=models/yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.50
TRACKER_TYPE=bytetrack
OCR_ENGINE=paddleocr

# ==========================================
# Frontend Configuration (Team 2)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/analytics
